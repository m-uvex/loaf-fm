Section: utils
Priority: optional
Architecture: amd64
Depends: libc6 (>= 2.31), libgl1, libglvnd0, libqt6core6, libqt6gui6, libqt6qml6, libqt6quick6, libqt6dbus6, qml6-module-qtquick, qml6-module-qtquick-controls, qml6-module-qtquick-layouts, qml6-module-qtquick-templates2, qml6-module-qtquick-shapes
